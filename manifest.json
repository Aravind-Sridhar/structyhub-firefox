{
  "manifest_version": 3,
  "name": "Structy Sync for Firefox",
  "version": "1.0.2",
  "description": "Automatically commit your passing Structy solutions to a GitHub repository. Not affiliated with Structy.",
  "icons": {
    "48": "assets/icon.svg",
    "96": "assets/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "structyhub-firefox@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": ["webRequest", "storage", "alarms"],
  "host_permissions": [
    "https://structy.net/*",
    "https://www.structy.net/*",
    "https://api.structy.net/*",
    "https://api.github.com/*",
    "https://github.com/login/*"
  ],
  "background": {
    "scripts": ["scripts/background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["https://structy.net/*", "https://www.structy.net/*"],
      "js": ["scripts/content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
